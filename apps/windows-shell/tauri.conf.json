{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rpackit Shell",
  "version": "0.1.0",
  "identifier": "dev.rpackit.shell",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../windows-spike/icons/icon.ico"],
    "windows": {
      "minimumWebview2Version": "149.0.4022.98",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
